{
  "schema": "ga-xin-golden/1.0",
  "version": "2.0.0",
  "created": "2026-11-19",
  "description": "CARE 框架回归评估集。任何框架/规则/引擎改动必须先跑 tests/run_tests.py 全绿。数字来源：源书例4-1（PDF p204/p206 文字解析页）、例2-33（p110）、p297、p109、p234；表格页 OCR 数字一律不采信。",
  "conventions": {
    "case_file": "相对技能根目录的实例 JSON 路径",
    "case_patch": "在 case_file 基础上递归深合并，用于只改少数字段的对照实验",
    "case": "内联完整实例（与 case_file 二选一）",
    "as_of": "覆盖实例 as_of，用于政策生效期模拟",
    "assertions": [
      "equals: 路径值相等（数值容差 0.01，布尔严格）",
      "gte / lte: 数值比较",
      "contains: 字符串或列表中包含指定值",
      "rule_active / rule_expired: 规则是否在生效/失效清单",
      "not_empty: 路径值非空"
    ]
  },
