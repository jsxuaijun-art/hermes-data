{
  "indexed_semantic": "\u6df1\u5ea6\u89e3\u6790\u9009\u9879\uff1a\u8be5\u4ed3\u5e93\u5df2\u5177\u5907 GitNexus \u5206\u6790\u6761\u4ef6\uff0c\u5f53\u524d\u662f\u8bed\u4e49\u589e\u5f3a\u6a21\u5f0f\u3002\u5982\u679c\u4f60\u613f\u610f\uff0c\u6211\u53ef\u4ee5\u7ee7\u7eed\u57fa\u4e8e GitNexus \u505a\u67b6\u6784\u3001\u8c03\u7528\u94fe\u3001API/\u8def\u7531\u3001\u5f71\u54cd\u8303\u56f4\u7b49\u66f4\u6df1\u5c42\u5206\u6790\u3002",
  "indexed_graph_only": "\u6df1\u5ea6\u89e3\u6790\u9009\u9879\uff1a\u8be5\u4ed3\u5e93\u5df2\u5177\u5907 GitNexus \u5206\u6790\u6761\u4ef6\uff0c\u4f46\u5f53\u524d\u662f\u5173\u952e\u8bcd/\u56fe\u8c31\u6a21\u5f0f\uff0c\u8fd8\u6ca1\u6709 embeddings\uff0c\u56e0\u6b64\u8bed\u4e49\u68c0\u7d22\u80fd\u529b\u4f1a\u5f31\u4e00\u4e9b\u3002\u5982\u679c\u4f60\u613f\u610f\uff0c\u6211\u4ecd\u53ef\u4ee5\u57fa\u4e8e GitNexus \u505a\u7ed3\u6784\u3001\u8c03\u7528\u94fe\u3001API/\u8def\u7531\u548c\u5f71\u54cd\u8303\u56f4\u5206\u6790\uff1b\u540c\u65f6\u4f60\u4e5f\u53ef\u4ee5\u5148\u5f00\u542f embeddings\uff0c\u518d\u83b7\u5f97\u66f4\u597d\u7684\u8bed\u4e49\u68c0\u7d22\u6548\u679c\u3002",
  "not_indexed": "\u6df1\u5ea6\u89e3\u6790\u9009\u9879\uff1a\u5f53\u524d\u8fd9\u4efd\u62a5\u544a\u57fa\u4e8e DeepWiki \u548c\u672c\u5730\u4ed3\u5e93\u5185\u5bb9\u3002\u82e5\u4f60\u9700\u8981\u66f4\u6df1\u7684\u7ed3\u6784\u7ea7\u5206\u6790\uff0c\u53ef\u4ee5\u7ee7\u7eed\u505a GitNexus \u7d22\u5f15\uff1b\u7d22\u5f15\u5b8c\u6210\u540e\uff0c\u6211\u53ef\u4ee5\u8fdb\u4e00\u6b65\u5206\u6790\u8c03\u7528\u94fe\u3001\u5173\u952e\u6a21\u5757\u5173\u7cfb\u3001API \u8def\u7531\u4e0e\u6539\u52a8\u5f71\u54cd\u8303\u56f4\u3002"
}
